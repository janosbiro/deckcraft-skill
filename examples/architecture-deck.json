{
  "schemaVersion": "0.1",
  "meta": {
    "title": "Governed AI agents",
    "audience": "Enterprise security and platform leaders",
    "objective": "Choose a control-plane approach"
  },
  "slides": [
    {
      "id": "01-system",
      "role": "argument",
      "claim": "An external control plane governs every agent action.",
      "layout": "system-map",
      "elements": [
        { "type": "text", "style": "title", "text": "Give the agent a control plane" },
        { "type": "system", "core": { "label": "Agent", "detail": "Proposes an action" }, "nodes": [
          { "label": "Identity", "detail": "Who can act" },
          { "label": "Tool gate", "detail": "What it may call" },
          { "label": "Runtime", "detail": "Where it executes" },
          { "label": "Evidence", "detail": "What actually happened" }
        ] }
      ]
    },
    {
      "id": "02-evidence",
      "role": "evidence",
      "claim": "Risk spans the full action path.",
      "layout": "evidence-map",
      "elements": [
        { "type": "text", "style": "title", "text": "Risk spans the action path" },
        { "type": "evidence", "areas": [
          { "label": "Goal", "detail": "Is the objective safe?" },
          { "label": "Tools", "detail": "Are privileges bounded?" },
          { "label": "Runtime", "detail": "Can actions be contained?" },
          { "label": "Oversight", "detail": "Can outcomes be reviewed?" }
        ], "takeaway": "Govern the system, not just the model.", "source": "Illustrative security review taxonomy; not measured incident counts" }
      ]
    },
    {
      "id": "03-plan",
      "role": "decision",
      "claim": "Scale autonomy only when evidence supports it.",
      "layout": "phased-plan",
      "elements": [
        { "type": "text", "style": "title", "text": "Earn autonomy in stages" },
        { "type": "phases", "steps": [
          { "label": "Inventory", "detail": "Find agents and accountable owners", "gate": "Ownership recorded" },
          { "label": "Pilot", "detail": "Use read-only or low-risk tools", "gate": "Controls tested" },
          { "label": "Scale", "detail": "Expand allowed actions deliberately", "gate": "Evidence reviewed" }
        ] }
      ]
    },
    {
      "id": "04-capabilities",
      "role": "process",
      "claim": "One platform provides shared controls.",
      "layout": "capability-stack",
      "elements": [
        { "type": "text", "style": "title", "text": "Build common controls once" },
        { "type": "capabilities", "spine": { "label": "Control plane", "detail": "Shared policy outside the agent" }, "layers": [
          { "label": "Identity", "detail": "Agent IDs and ownership" },
          { "label": "Tool gate", "detail": "Approved actions and credentials" },
          { "label": "Runtime", "detail": "Isolation and approval limits" },
          { "label": "Evidence", "detail": "Traces, evaluations, rollback" }
        ] }
      ]
    }
  ]
}
