{
  "name": "deckcraft-skill",
  "version": "0.1.0",
  "private": true,
  "description": "A portable agent skill for professional editable PowerPoint decks.",
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "validate:ir": "node scripts/validate_deck_ir.mjs",
    "build:example": "node scripts/build-deck.mjs examples/minimal-deck.json artifacts/example.pptx",
    "preview:example": "node scripts/render-preview.mjs artifacts/example.pptx artifacts/preview",
    "build:enterprise": "node scripts/build-deck.mjs examples/enterprise-deck.json artifacts/enterprise.pptx",
    "preview:enterprise": "node scripts/render-preview.mjs artifacts/enterprise.pptx artifacts/preview-enterprise",
    "build:architecture": "node scripts/build-deck.mjs examples/architecture-deck.json artifacts/architecture.pptx",
    "preview:architecture": "node scripts/render-preview.mjs artifacts/architecture.pptx artifacts/preview-architecture",
    "qa:lo": "node scripts/qa-libreoffice.mjs artifacts/example.pptx artifacts/final",
    "qa:compare": "node scripts/compare-renders.mjs artifacts/preview artifacts/final/example.pdf artifacts/comparison",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@office-kit/pptx": "0.21.0",
    "@office-kit/pptx-preview": "0.11.0"
  }
}
